{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "resolveJsonModule": true, "allowImportingTsExtensions": true, "strict": true, "skipLibCheck": true, "noEmit": true,
    "verbatimModuleSyntax": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "scripts/*.ts", "*.ts"]
}
